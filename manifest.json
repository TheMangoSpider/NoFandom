{
  "manifest_version": 3,
  "name": "No Fandom",
  "version": "3.1",
  "description": "Removes Fandom (Wikia) wikis from your search results. Runs locally and collects nothing.",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "no-fandomr@werneck-matheus.com",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.google.com/search*",
        "*://www.google.co.uk/search*",
        "*://www.google.ca/search*",
        "*://www.google.com.au/search*",
        "*://www.google.de/search*",
        "*://www.google.fr/search*",
        "*://www.google.es/search*",
        "*://www.google.it/search*",
        "*://www.google.nl/search*",
        "*://www.google.pl/search*",
        "*://www.google.pt/search*",
        "*://www.google.se/search*",
        "*://www.google.ie/search*",
        "*://www.google.co.nz/search*",
        "*://www.google.co.in/search*",
        "*://www.google.com.br/search*",
        "*://www.google.com.mx/search*",
        "*://www.google.co.jp/search*",
        "*://www.google.ru/search*",
        "*://www.google.co.za/search*",
        "*://www.bing.com/search*",
        "*://duckduckgo.com/*",
        "*://search.brave.com/search*",
        "*://*.ecosia.org/search*"
      ],
      "js": [
        "hide.js"
      ],
      "css": [
        "hide.css"
      ],
      "run_at": "document_start"
    }
  ]
}